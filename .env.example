# ── Rang — environment variables ─────────────────────────────
# Copy to .env and fill in. Never commit .env.

# --- Security -------------------------------------------------
# CHANGE THIS. Signs every JWT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------
# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+psycopg://rang:rang@localhost:5432/rang
# On Vercel the app automatically falls back to /tmp when unset.
DATABASE_URL=sqlite:///./rang.db

# --- Image generation -----------------------------------------
# "local"  = procedural renderer, no key, no network, deterministic (default)
# "gemini" = Google image model, requires GEMINI_API_KEY below
IMAGE_PROVIDER=local

# Only needed when IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# --- Limits ---------------------------------------------------
MAX_PROMPT_LENGTH=800
MAX_NEGATIVE_PROMPT_LENGTH=400
MAX_IMAGE_SIDE=1536
MIN_IMAGE_SIDE=256
RATE_LIMIT_GENERATE=20/minute
RATE_LIMIT_DEFAULT=120/minute

# --- CORS -----------------------------------------------------
# "*" allows everything (fine for local dev). In production, list your origins:
#   CORS_ORIGINS=https://rang.example.com,https://www.rang.example.com
CORS_ORIGINS=*
